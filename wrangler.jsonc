{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tatto-cbt-mogo",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Screens are served as Static Assets (not counted against the Workers request quota).
  // Only /api/* reaches the Worker first; every other unknown path falls back to index.html (SPA).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tatto-cbt-db",
      // Replace with the real id from `wrangler d1 create tatto-cbt-db` (docs/SETUP.md step 4).
      // Local dev works with this placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tatto-cbt-files"
    }
  ],
  // Per-IP request limits (per Cloudflare location, approximate). One academy behind one IP may be
  // 30–100 examinees, so the limits are per crowd, not per person. namespace_id: unique per account.
  "ratelimits": [
    { "name": "RL_API", "namespace_id": "1001", "simple": { "limit": 1200, "period": 60 } },
    { "name": "RL_ENTRY", "namespace_id": "1002", "simple": { "limit": 200, "period": 60 } }
  ],
  // Closes exam attempts whose time ran out while the examinee was offline (free Cron Trigger).
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": {
    "enabled": true
  }
}
